pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'test', 'prod'],
            description: 'Target deployment environment'
        )

        booleanParam(
            name: 'APPLY',
            defaultValue: false,
            description: 'Apply Terraform changes'
        )

        string(
            name: 'BUCKET_NAME',
            defaultValue: 'retail-data-engineering-saravanan-2026',
            description: 'Globally unique S3 bucket name'
        )
    }

    environment {
        TF_DIR = 'terraform'
        AWS_REGION = 'ap-south-1'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Format Check') {
            steps {
                sh '''
                    terraform -chdir=$TF_DIR fmt -check
                '''
            }
        }

        stage('Terraform Init') {
            steps {
                withAWS(
                    credentials: 'jenkins-terraform',
                    region: "${AWS_REGION}"
                ) {
                    sh '''
                        echo "========================================"
                        echo "AWS Environment Check"
                        echo "========================================"

                        env | grep '^AWS_' | sed 's/=.*/=<set>/'

                        echo ""
                        echo "========================================"
                        echo "AWS CLI Version"
                        echo "========================================"

                        aws --version

                        echo ""
                        echo "========================================"
                        echo "AWS Caller Identity"
                        echo "========================================"

                        aws sts get-caller-identity

                        echo ""
                        echo "========================================"
                        echo "Terraform Init"
                        echo "========================================"

                        terraform -chdir=$TF_DIR init -input=false
                    '''
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                sh '''
                    terraform -chdir=$TF_DIR validate
                '''
            }
        }

        stage('AWS Identity Check') {
            steps {
                withAWS(
                    credentials: 'jenkins-terraform',
                    region: "${AWS_REGION}"
                ) {
                    sh '''
                        echo "Checking AWS authentication..."
                        aws sts get-caller-identity
                    '''
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withAWS(
                    credentials: 'jenkins-terraform',
                    region: "${AWS_REGION}"
                ) {
                    sh '''
                        echo "Running Terraform plan..."

                        terraform -chdir=$TF_DIR plan \
                          -input=false \
                          -var="environment=$ENVIRONMENT" \
                          -var="bucket_name=$BUCKET_NAME"
                    '''
                }
            }
        }

        stage('Production Approval') {
            when {
                allOf {
                    expression {
                        params.ENVIRONMENT == 'prod'
                    }

                    expression {
                        params.APPLY
                    }
                }
            }

            steps {
                input(
                    message: 'Approve production Terraform deployment?',
                    ok: 'Approve Deployment'
                )
            }
        }

        stage('Terraform Apply') {
            when {
                expression {
                    params.APPLY
                }
            }

            steps {
                withAWS(
                    credentials: 'jenkins-terraform',
                    region: "${AWS_REGION}"
                ) {
                    sh '''
                        echo "Running Terraform apply..."

                        terraform -chdir=$TF_DIR apply \
                          -input=false \
                          -auto-approve \
                          -var="environment=$ENVIRONMENT" \
                          -var="bucket_name=$BUCKET_NAME"
                    '''
                }
            }
        }
    }

    post {
        always {
            echo "Terraform pipeline completed for environment: ${params.ENVIRONMENT}"
        }

        success {
            echo "Terraform pipeline completed successfully."
        }

        failure {
            echo "Terraform pipeline failed. Review the Jenkins console logs."
        }
    }
}